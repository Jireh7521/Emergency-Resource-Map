# Copy this file to .env and fill in real values.

# For local development without Postgres installed, SQLite works out of the box:
DATABASE_URL=sqlite:///./emergency_resources.db

# When you're ready to switch to Postgres (matches the project spec), use something like:
# DATABASE_URL=postgresql://username:password@localhost:5432/emergency_resource_map

# Used to sign admin login tokens (JWT). Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and never commit the real value.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
